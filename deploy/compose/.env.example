# What this deployment is told that is secret or its own. Copy to `.env`,
# fill it in, and `chmod 600 .env` (README.md).

# The address people open: Caddy gets its certificate from Let's Encrypt, so
# its DNS points at this host and ports 80 and 443 reach it.
LOFT_DOMAIN=loft.example.com

# The address of roster's page, where the tenant's administrators manage its
# members (D87): a host of its own, pointing at this host as LOFT_DOMAIN does.
ROSTER_DOMAIN=id.example.com

# The tenant at roster this deployment serves, which is its workspace (D85):
# made at roster first (README.md), then put up by `loft init`.
LOFT_TENANT=acme

# Letters and digits only: it goes into a database address as it is.
#   openssl rand -hex 24
POSTGRES_PASSWORD=
# roster's own database user, which Loft's does not reach. The same rule.
#   openssl rand -hex 24
ROSTER_DB_PASSWORD=

# What a second factor's seed is sealed under at roster. Kept with the
# backups, and never changed once anybody has a factor.
#   openssl rand -base64 32
ROSTER_VOUCH_KEY=

# The key Loft acts with at roster: the tenant's own (`rt_…`), which
# `roster key add` prints once after Loft is installed there (README.md).
# Empty until then, and Loft does not start without it.
ROSTER_KEY=

# Signs the download links, the same on every replica.
#   openssl rand -base64 32
LOFT_SIGNING_KEY=

# The SMTP server the notices somebody is told by mail as well go out
# through. Empty mails nothing: they are told in the app only.
LOFT_MAIL_HOST=
LOFT_MAIL_PORT=587
LOFT_MAIL_USERNAME=
LOFT_MAIL_PASSWORD=
LOFT_MAIL_FROM="Loft <no-reply@example.com>"

# What the image is called and says it is: `git describe --tags --always`.
LOFT_VERSION=

# roster's image, by tag or digest. The one compose.yaml names is a roster
# this build of Loft runs against.
#ROSTER_IMAGE=ghcr.io/lesomnus/roster@sha256:…

# Search on OpenSearch (README.md, "검색을 켜려면"): after ./search-init.sh,
#   COMPOSE_FILE=compose.yaml:compose.search.yaml
# and the heap its JVM is given, of a node of a few gigabytes.
LOFT_SEARCH_HEAP=512m

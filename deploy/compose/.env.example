# What this deployment is told that is secret or its own. Copy to `.env`,
# fill it in, and `chmod 600 .env` (README.md).

# The address people open: Caddy gets its certificate from Let's Encrypt, so
# its DNS points at this host and ports 80 and 443 reach it.
LOFT_DOMAIN=loft.example.com

# Letters and digits only: it goes into a database address as it is.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs the download links, the same on every replica.
#   openssl rand -base64 32
LOFT_SIGNING_KEY=

# The SMTP server invitations go out through. Empty writes them to the log.
LOFT_MAIL_HOST=
LOFT_MAIL_PORT=587
LOFT_MAIL_USERNAME=
LOFT_MAIL_PASSWORD=
LOFT_MAIL_FROM="Loft <no-reply@example.com>"

# What the image is called and says it is: `git describe --tags --always`.
LOFT_VERSION=

# Search on OpenSearch (README.md, "검색을 켜려면"): after ./search-init.sh,
#   COMPOSE_FILE=compose.yaml:compose.search.yaml
# and the heap its JVM is given, of a node of a few gigabytes.
LOFT_SEARCH_HEAP=512m

# Workspaces' own domains (compose.domains.yaml, README.md): the name a
# workspace's CNAME points at -- LOFT_DOMAIN unless said -- and more of
# Caddy's global options, such as `email ops@example.com` for the ACME account.
LOFT_EDGE_HOST=
LOFT_EDGE_OPTIONS=

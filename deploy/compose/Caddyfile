# In front of every `loft serve`: a certificate for LOFT_DOMAIN from Let's
# Encrypt (Caddy's own CA for `localhost`), and each request to one of them.
# Loft says its own security headers, so nothing here adds any.
#
# An ACME account needs no e-mail; to give one, a global block with
# `email ops@example.com` above the site. Workspaces' own domains are
# `Caddyfile.domains`, which reads this one (README.md).

# How a request reaches Loft, wherever it came to.
(loft) {
	encode zstd gzip
	reverse_proxy {
		# Every replica `loft` answers to, asked again as they come and go.
		dynamic a {
			name loft
			port 8080
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 5s
		# A watch is a stream: each part goes on as it is written.
		flush_interval -1
	}
}

{$LOFT_DOMAIN} {
	import loft
}

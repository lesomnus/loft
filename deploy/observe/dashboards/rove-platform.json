    {
      "type": "timeseries",
      "title": "디스크 사용률",
      "description": "노드 수집기(hostmetrics)의 파일 시스템 사용률. local-path 볼륨은 노드 디스크에 있습니다",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time, concat(getMacro('nickname'), ' ', Attributes['mountpoint']) AS series, max(Value) AS value FROM ${db}.otel_metrics_gauge${suffix} WHERE $__timeFilter(TimeUnix) AND MetricName = 'system.filesystem.utilization' GROUP BY time, series ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []

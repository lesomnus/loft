    {
      "type": "timeseries",
      "title": "DB 크기",
      "description": "rove와 내장 roster의 데이터베이스",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time, Attributes['datname'] AS series, argMax(Value, TimeUnix) AS value FROM ${db}.otel_metrics_gauge${suffix} WHERE $__timeFilter(TimeUnix) AND MetricName = 'cnpg_pg_database_size_bytes' AND Attributes['datname'] NOT IN ('template0', 'template1', 'postgres') GROUP BY time, series ORDER BY time"
        }
      ],
      "fieldConfig": {

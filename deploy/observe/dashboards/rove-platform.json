    {
      "type": "stat",
      "title": "복구할 수 있는 가장 이른 시점",
      "description": "보존 기간(retentionPolicy) 안에서 시점 복원이 닿는 가장 이른 시각",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT argMax(Value, TimeUnix) * 1000 AS value FROM ${db}.otel_metrics_gauge${suffix} WHERE $__timeFilter(TimeUnix) AND MetricName = 'barman_cloud_cloudnative_pg_io_first_recoverability_point'"

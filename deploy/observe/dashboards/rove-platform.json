    {
      "type": "timeseries",
      "title": "보관한 WAL 조각 (누적)",
      "description": "pg_stat_archiver.archived_count",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(TimeUnix) AS time, Attributes['cluster'] AS series, max(Value) AS value FROM ${db}.otel_metrics_sum${suffix} WHERE $__timeFilter(TimeUnix) AND MetricName = 'cnpg_pg_stat_archiver_archived_count' GROUP BY time, series ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 5

    {
      "type": "table",
      "title": "인증서 만료",
      "description": "cert-manager가 관리하는 인증서. 14일 안에 끝나는 것이 있으면 갱신을 봅니다",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT Attributes['namespace'] AS namespace, Attributes['name'] AS certificate, Attributes['issuer_name'] AS issuer, (argMax(Value, TimeUnix) - toUnixTimestamp(now())) / 86400 AS days_left FROM ${db}.otel_metrics_gauge${suffix} WHERE $__timeFilter(TimeUnix) AND MetricName = 'certmanager_certificate_expiration_timestamp_seconds' GROUP BY namespace, certificate, issuer ORDER BY days_left"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "days_left"
            },
            "properties": [
              {
                "id": "unit",
                "value": "d"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      }
    },
    {
      "type": "table",
      "title": "재시작한 컨테이너",
      "description": "재시작 횟수가 0이 아닌 컨테이너. `spin failed`나 메모리 초과(OOMKilled)가 여기서 보입니다",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT ns, pod, container, max(v) - min(v) AS restarts_in_range, max(v) AS restarts FROM (SELECT ResourceAttributes['k8s.namespace.name'] AS ns, ResourceAttributes['k8s.pod.name'] AS pod, ResourceAttributes['k8s.container.name'] AS container, Value AS v FROM ${db}.otel_metrics_gauge${suffix} WHERE $__timeFilter(TimeUnix) AND MetricName = 'k8s.container.restarts') GROUP BY ns, pod, container HAVING restarts > 0 ORDER BY restarts_in_range DESC, restarts DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      }
    },
    {
      "type": "table",
      "title": "Running이 아닌 파드",
      "description": "지금(최근 5분) Pending, Failed, Unknown인 파드. 끝난 Job의 파드(Succeeded)는 뺍니다",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT ns, pod, multiIf(phase = 1, 'Pending', phase = 4, 'Failed', phase = 5, 'Unknown', toString(phase)) AS phase FROM (SELECT ResourceAttributes['k8s.namespace.name'] AS ns, ResourceAttributes['k8s.pod.name'] AS pod, argMax(Value, TimeUnix) AS phase FROM ${db}.otel_metrics_gauge${suffix} WHERE TimeUnix > now() - INTERVAL 5 MINUTE AND MetricName = 'k8s.pod.phase' GROUP BY ns, pod) WHERE phase NOT IN (2, 3) ORDER BY ns, pod"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 14,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      }
    },
    {
      "type": "table",
      "title": "실패한 Job",
      "description": "볼륨 백업(rove-volumes-backup) 같은 Job의 실패한 파드 수",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT ResourceAttributes['k8s.namespace.name'] AS ns, ResourceAttributes['k8s.job.name'] AS job, argMax(Value, TimeUnix) AS failed_pods FROM ${db}.otel_metrics_gauge${suffix} WHERE $__timeFilter(TimeUnix) AND MetricName = 'k8s.job.failed' GROUP BY ns, job HAVING failed_pods > 0 ORDER BY ns, job"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,

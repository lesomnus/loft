        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "WAL 보관 실패 (누적)",
      "description": "pg_stat_archiver.failed_count. 늘어나면 버킷이나 자격 증명을 봅니다",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT argMax(Value, TimeUnix) AS value FROM ${db}.otel_metrics_sum${suffix} WHERE $__timeFilter(TimeUnix) AND MetricName = 'cnpg_pg_stat_archiver_failed_count'"

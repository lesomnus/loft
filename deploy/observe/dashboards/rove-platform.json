{
  "uid": "rove-platform",
  "title": "Rove — 플랫폼",
  "description": "Rove 밖에서 보는 것: 백업(CNPG), DB, 인증서(cert-manager), 쿠버네티스, 노드. 클러스터 안 수집기와 노드 수집기가 보낸 지표",
  "tags": [
    "rove"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 41,
  "templating": {
    "list": [
      {
        "name": "db",
        "label": "ClickHouse 데이터베이스",
        "type": "custom",
        "query": "otel",
        "current": {
          "text": "otel",
          "value": "otel"
        },
        "options": [
          {
            "text": "otel",
            "value": "otel",
            "selected": true
          }
        ],
        "hide": 2
      },
      {
        "name": "suffix",
        "label": "테이블 접미사",
        "type": "custom",
        "query": "_dist,none",
        "current": {
          "text": "_dist",
          "value": "_dist"
        },
        "options": [
          {
            "text": "_dist",
            "value": "_dist",
            "selected": true
          },
          {
            "text": "none",
            "value": "",
            "selected": false
          }
        ],
        "description": "ClickHouse 노드 여럿이면 분산 테이블(_dist), 하나면 접미사 없음"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "백업",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "마지막 베이스 백업 뒤",
      "description": "barman-cloud가 마지막으로 끝낸 베이스 백업에서 지금까지. 매일 하면 26시간을 넘지 않아야 합니다",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT toUnixTimestamp(now()) - argMax(Value, TimeUnix) AS value FROM ${db}.otel_metrics_gauge${suffix} WHERE $__timeFilter(TimeUnix) AND MetricName = 'barman_cloud_cloudnative_pg_io_last_available_backup_timestamp'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 93600
              },
              {
                "color": "red",
                "value": 129600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "마지막 WAL 보관 뒤",
      "description": "쓰기가 없으면 WAL 조각이 차지 않아 보관하지 않습니다(archive_timeout은 쓰기가 있을 때만). 쓰기가 있는데 길어지면 문제입니다",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "clickhouse"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT argMax(Value, TimeUnix) AS value FROM ${db}.otel_metrics_gauge${suffix} WHERE $__timeFilter(TimeUnix) AND MetricName = 'cnpg_pg_stat_archiver_seconds_since_last_archival'"

        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT concat(LogAttributes.rpc.service::String, '/', LogAttributes.rpc.method::String) AS method, count() AS calls, quantile(0.5)(LogAttributes.server.elapsed_ns::UInt64 / 1e6) AS p50_ms, quantile(0.95)(LogAttributes.server.elapsed_ns::UInt64 / 1e6) AS p95_ms, quantile(0.99)(LogAttributes.server.elapsed_ns::UInt64 / 1e6) AS p99_ms, countIf(LogAttributes.rpc.grpc.status::String != 'OK') AS not_ok, countIf(LogAttributes.rpc.grpc.status::String IN ('Internal', 'Unknown', 'Unavailable', 'DeadlineExceeded', 'DataLoss', 'Unimplemented')) AS server_errors FROM ${db}.otel_logs${suffix} WHERE $__timeFilter(Timestamp) AND ServiceName = 'rove' AND Body = 'gRPC out' AND NOT startsWith(LogAttributes.rpc.service::String, 'roster.') GROUP BY method ORDER BY calls DESC LIMIT 50"
        }
      ],

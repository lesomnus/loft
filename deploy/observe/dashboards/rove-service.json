            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() / dateDiff('second', $__fromTime, $__toTime) AS value FROM ${db}.otel_logs${suffix} WHERE $__timeFilter(Timestamp) AND ServiceName = 'rove' AND Body = 'gRPC out' AND NOT startsWith(LogAttributes.rpc.service::String, 'roster.')"

          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(Timestamp) AS time, concat(LogAttributes.rpc.service::String, '/', LogAttributes.rpc.method::String) AS method, count() / $__interval_s AS calls FROM ${db}.otel_logs${suffix} WHERE $__timeFilter(Timestamp) AND ServiceName = 'rove' AND Body = 'gRPC out' AND NOT startsWith(LogAttributes.rpc.service::String, 'roster.') GROUP BY time, method ORDER BY time"

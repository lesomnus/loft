            "uid": "clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT countIf(LogAttributes.rpc.grpc.status::String IN ('Internal', 'Unknown', 'Unavailable', 'DeadlineExceeded', 'DataLoss', 'Unimplemented')) / count() AS value FROM ${db}.otel_logs${suffix} WHERE $__timeFilter(Timestamp) AND ServiceName = 'rove' AND Body = 'gRPC out' AND NOT startsWith(LogAttributes.rpc.service::String, 'roster.')"

          "rawSql": "SELECT quantile(0.95)(LogAttributes.server.elapsed_ns::UInt64 / 1e6) AS value FROM ${db}.otel_logs${suffix} WHERE $__timeFilter(Timestamp) AND ServiceName = 'rove' AND Body = 'gRPC out' AND NOT startsWith(LogAttributes.rpc.service::String, 'roster.')"

# What an image is built from is the checkout's source and nothing it made or
# holds: a desk's database never goes into an image. The repository itself
# goes in, so that the build says which commit it is (`loft version`).
data/
**/*.db
**/*.db-*
ts/node_modules
ts/dist
ts/test-results
ts/playwright-report
deploy/compose/.env
deploy/compose/secrets
